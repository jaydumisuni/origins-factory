{
  "invalid_contracts": [
    {
      "name": "write_grant_without_read_grant",
      "base": "scope",
      "set": {
        "resource_reads": [],
        "resource_writes": [{"resource_id": "worktree:33333333-3333-4333-8333-333333333333", "prefix": "src"}]
      },
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "environment_secret_assignment_not_name",
      "base": "scope",
      "set": {"environment_names": ["API_KEY=secret"]},
      "expected_error": "INVALID_ENVIRONMENT_NAME"
    },
    {
      "name": "fully_denied_read_grant",
      "base": "scope",
      "set": {
        "resource_reads": [{"resource_id": "worktree:33333333-3333-4333-8333-333333333333", "prefix": ".origins"}],
        "resource_writes": []
      },
      "expected_error": "CONTRADICTORY_SCOPE"
    },
    {
      "name": "lease_zero_fence",
      "base": "lease",
      "set": {"fence": 0},
      "expected_error": "INVALID_FENCE"
    },
    {
      "name": "lease_invalid_approval_digest",
      "base": "lease",
      "set": {"approval_digest": "abc"},
      "expected_error": "INVALID_DIGEST"
    },
    {
      "name": "lease_persistent_without_execute",
      "base": "lease",
      "set": {
        "effects": ["observe"],
        "persistent_process_allowed": true
      },
      "expected_error": "INVALID_LEASE"
    }
  ],
  "relations": [
    {
      "name": "child_expiry_extension",
      "relation": "child_scope",
      "child_set": {"expires_at": "2026-08-09T15:00:00Z"},
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "child_persistent_process_escalation",
      "relation": "child_scope",
      "child_set": {"persistent_process_allowed": true},
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "child_environment_widening",
      "relation": "child_scope",
      "child_set": {"environment_names": ["LANG", "PATH", "SECRET"]},
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "child_network_host_widening",
      "relation": "child_scope",
      "child_set": {"network_hosts": ["api.example.com", "evil.example.com"]},
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "child_network_class_switch",
      "relation": "child_scope",
      "child_set": {
        "network_mode": "delegated_remote",
        "network_hosts": ["support.example.com"],
        "delegated_remote_authority": true
      },
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "child_resource_substitution",
      "relation": "child_scope",
      "child_set": {
        "resource_reads": [{"resource_id": "worktree:55555555-5555-4555-8555-555555555555", "prefix": "src"}],
        "resource_writes": []
      },
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "child_drops_parent_deny",
      "relation": "child_scope",
      "child_set": {"resource_denies": []},
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "lease_scope_identity_substitution",
      "relation": "lease_scope",
      "lease_set": {"scope_id": "55555555-5555-4555-8555-555555555555"},
      "expected_error": "LEASE_ESCALATION"
    },
    {
      "name": "lease_expiry_extension",
      "relation": "lease_scope",
      "lease_set": {"expires_at": "2026-08-09T15:00:00Z"},
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "lease_persistent_process_escalation",
      "relation": "lease_scope",
      "lease_set": {"persistent_process_allowed": true},
      "expected_error": "LEASE_ESCALATION"
    },
    {
      "name": "lease_environment_widening",
      "relation": "lease_scope",
      "lease_set": {"environment_names": ["LANG", "SECRET"]},
      "expected_error": "SCOPE_ESCALATION"
    },
    {
      "name": "lease_network_class_switch",
      "relation": "lease_scope",
      "lease_set": {
        "network_mode": "delegated_remote",
        "network_hosts": ["support.example.com"],
        "delegated_remote_authority": true
      },
      "expected_error": "SCOPE_ESCALATION"
    }
  ]
}
