      "base": "lease",
      "set": {"fence": 0},
      "expected_error": "INVALID_FENCE"
    },
    {
      "name": "scope_zero_fence",
      "base": "scope",
      "set": {"fence": 0},
      "expected_error": "INVALID_FENCE"
    },
    {
